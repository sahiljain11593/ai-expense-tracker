# Copy to .streamlit/secrets.toml for local dev (folder is gitignored).
# On Streamlit Cloud: paste equivalent sections in App → Settings → Secrets.

# --- Firebase Google Sign-In (recommended for production) ---
[firebase]
apiKey = "YOUR_FIREBASE_WEB_API_KEY"
authDomain = "your-project.firebaseapp.com"
projectId = "your-project-id"
appId = "YOUR_FIREBASE_APP_ID"

[auth]
allowed_email = "your@gmail.com"

# --- Google Drive backup (OAuth; redirect must match your app URL exactly) ---
[google]
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"
redirect_uri = "https://your-app-name.streamlit.app"
drive_folder_id = ""

# --- AI translation (optional; can also enter in app sidebar) ---
[openai]
api_key = "sk-..."

# [gemini]
# api_key = "..."
